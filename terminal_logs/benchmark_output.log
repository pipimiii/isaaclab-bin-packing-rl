#vector 
rm -f benchmark_results/*.csv
HEADLESS=1 ENABLE_CAMERAS=1 python -u mycodes/benchmark_timing.py \
  --num_cubes 5 \
  --cube_size 0.05 \
  --num_envs 4 \
  --num_episodes 100 \
  --max_episode_steps 1500 \
  --settle_max_steps 160 \
  --final_settle_max_steps 400 \
  --drop_xy_half 0.10 \
  --obs_type vector \
  --reward_type hybrid \
  --benchmark_name vector_5cubes_4envs
