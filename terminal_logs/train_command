#observation space
vector
image
multimodal
    #vector obs_type(used for ppo)
        cube local positions
        cube linear velocities
        active cube mask
        dropped cube mask
        progress information
        #tells the policy where the cubes are, how fast they are moving, which cubes are active, which cubes have already been dropped, and how far the episode has progressed.
    #"inside the bin" def
    |x_local| ≤ bin_half_x
    |y_local| ≤ bin_half_y
    bin_floor_z ≤ z_local ≤ bin_top_z
    #stability def
    speed ≤ stable_speed_thresh
    stable_speed_thresh = 0.05 m/s
    stable_steps = 15 consecutive physics steps, 15 × 0.01667 ≈ 0.25 s
    #success condition:
    A single cube succeeds if: inside bin + stable
    An environment succeeds if: all active cubes are successful
    #terminal condition:
    An episode terminates when either: all active cubes are inside and stable
    or: max_episode_steps is reached

